# Dev image: typecheck, lint, and tests. Build with: podman build -t tickets-dev -f Containerfile.dev .
FROM quay.io/hummingbird/curl:8-builder
USER 0
ARG TARGETARCH
# renovate: datasource=github-releases depName=denoland/deno extractVersion=^v(?<version>.*)$
ARG DENO_VERSION=2.9.8
# renovate: datasource=github-releases depName=biomejs/biome extractVersion=^@biomejs/biome@(?<version>.*)$
ARG BIOME_VERSION=2.6.6
# renovate: datasource=github-releases depName=stripe/stripe-mock extractVersion=^v(?<version>.*)$
ARG STRIPE_MOCK_VERSION=0.188.0
RUN dnf install -y curl tar gzip git unzip openssl jq && dnf clean all
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) arch=x86_64; ba=x64; sm=amd64 ;; \
      arm64) arch=aarch64; ba=arm64; sm=arm64 ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    deno_url="https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-${arch}-unknown-linux-gnu.zip"; \
    curl -fLO --proto =https "${deno_url}"; \
    curl -fL --proto =https "${deno_url}.sha256sum" | sha256sum -c -; \
    unzip -o deno-${arch}-unknown-linux-gnu.zip -d /usr/local/bin; \
    curl -fL --proto =https -o biome-linux-${ba} "https://github.com/biomejs/biome/releases/download/%40biomejs%2Fbiome%40${BIOME_VERSION}/biome-linux-${ba}"; \
    biome_sha="$(curl -fsSL --proto =https "https://api.github.com/repos/biomejs/biome/releases/tags/%40biomejs%2Fbiome%40${BIOME_VERSION}" | jq -r ".assets[] | select(.name==\"biome-linux-${ba}\") | .digest" | sed 's/^sha256://')"; \
    test -n "${biome_sha}"; \
    echo "${biome_sha}  biome-linux-${ba}" | sha256sum -c -; \
    install -m 0755 biome-linux-${ba} /usr/local/bin/biome; \
    sm_file="stripe-mock_${STRIPE_MOCK_VERSION}_linux_${sm}.tar.gz"; \
    sm_base="https://github.com/stripe/stripe-mock/releases/download/v${STRIPE_MOCK_VERSION}"; \
    curl -fLO --proto =https "${sm_base}/${sm_file}"; \
    curl -fL --proto =https "${sm_base}/stripe-mock_${STRIPE_MOCK_VERSION}_checksums.txt" | grep " ${sm_file}\$" | sha256sum -c -; \
    tar -xzf "${sm_file}" -C /usr/local/bin stripe-mock; \
    rm -f deno-${arch}-unknown-linux-gnu.zip biome-linux-${ba} "${sm_file}"

RUN useradd --create-home --uid 1000 dev && mkdir -p /deno-dir && chown dev /deno-dir
ENV DENO_DIR=/deno-dir \
    STRIPE_MOCK_BIN=/usr/local/bin/stripe-mock
VOLUME /deno-dir
ENTRYPOINT []
USER dev
WORKDIR /work
