{
  "name": "tickets",
  "version": "1.0.0",
  "exports": "./src/index.ts",
  "tasks": {
    "serve": "deno run $SERVE_WATCH --env-file --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi src/index.ts",
    "start": "deno task build:static && deno task serve",
    "dev": "deno task build:static && SERVE_WATCH=--watch deno task serve",
    "build:static": "deno run --allow-env --allow-read --allow-write --allow-run --allow-net scripts/build-static-assets.ts"
  },
  "imports": {
    "#accounting/": "./src/shared/accounting/",
    "#booking/": "./src/shared/booking/",
    "#crypto/": "./src/shared/crypto/",
    "#db/": "./src/shared/db/",
    "#fp": "./src/fp.ts",
    "#fp-strings": "./src/fp-strings.ts",
    "#i18n": "./src/shared/i18n.ts",
    "#jsx/": "./src/shared/jsx/",
    "#jsx/jsx-dev-runtime": "./src/shared/jsx/jsx-runtime.ts",
    "#jsx/jsx-runtime": "./src/shared/jsx/jsx-runtime.ts",
    "#locales/": "./src/locales/",
    "#payment/": "./src/shared/payment/",
    "#routes": "./src/features/app/request.ts",
    "#routes/": "./src/features/",
    "#scripts/": "./scripts/",
    "#shared/": "./src/shared/",
    "#src/": "./src/",
    "#static/": "./src/ui/static/",
    "#templates/": "./src/ui/templates/",
    "#types": "./src/shared/types.ts",
    "@botpoison/browser": "npm:@botpoison/browser@^0.1.30",
    "@bunny.net/edgescript-sdk": "npm:@bunny.net/edgescript-sdk@^0.12.1",
    "@bunny.net/storage-sdk": "npm:@bunny.net/storage-sdk@^0.3.1",
    "@formatjs/icu-messageformat-parser": "npm:@formatjs/icu-messageformat-parser@^2.11",
    "@iframe-resizer/child": "npm:@iframe-resizer/child@^5.5.9",
    "@iframe-resizer/core": "npm:@iframe-resizer/core@^5.5.9",
    "@iframe-resizer/parent": "npm:@iframe-resizer/parent@^5.5.9",
    "@jridgewell/sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.5",
    "@jsquash/jpeg/": "npm:/@jsquash/jpeg@^1.5.0/",
    "@jsquash/png/": "npm:/@jsquash/png@^3.1.1/",
    "@jsquash/webp/": "npm:/@jsquash/webp@^1.5.0/",
    "@libsql/client": "npm:@libsql/client@^0.17.2",
    "@libsql/core/config": "npm:@libsql/core@0.17.2/config",
    "@libsql/core/uri": "npm:@libsql/core@0.17.2/uri",
    "@libsql/core/util": "npm:@libsql/core@0.17.2/util",
    "@libsql/hrana-client": "npm:@libsql/hrana-client@0.9.0",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@sentry/core": "npm:@sentry/core@^10.60.0",
    "@sentry/deno": "npm:@sentry/deno@^10.60.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/collections": "jsr:@std/collections@^1.2.0",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/http": "jsr:@std/http@^1.1.1",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "./test/test-utils/bdd.ts",
    "auto-console-group": "npm:auto-console-group@^1.3.0",
    "esbuild": "npm:esbuild@^0.28.0",
    "fast-check": "npm:fast-check@^3.23.0",
    "fflate": "npm:fflate@^0.8.2",
    "happy-dom": "npm:happy-dom@^15.11.7",
    "intl-messageformat": "npm:intl-messageformat@^10",
    "jsqr": "npm:jsqr@^1.4.0",
    "leaflet": "npm:leaflet@^1.9.4",
    "liquidjs": "npm:liquidjs@^10.25.5",
    "marked": "npm:marked@^18.0.0",
    "promise-limit": "npm:promise-limit@2.7.0",
    "prosemirror-commands": "npm:prosemirror-commands@^1.7.0",
    "prosemirror-history": "npm:prosemirror-history@^1.4.1",
    "prosemirror-inputrules": "npm:prosemirror-inputrules@^1.5.0",
    "prosemirror-keymap": "npm:prosemirror-keymap@^1.2.3",
    "prosemirror-markdown": "npm:prosemirror-markdown@^1.13.4",
    "prosemirror-model": "npm:prosemirror-model@^1.25.0",
    "prosemirror-schema-list": "npm:prosemirror-schema-list@^1.5.0",
    "prosemirror-state": "npm:prosemirror-state@^1.4.4",
    "prosemirror-view": "npm:prosemirror-view@^1.42.0",
    "sass": "npm:sass@^1.101.0",
    "stripe": "npm:stripe@^22.0.1",
    "temporal-polyfill": "npm:temporal-polyfill@^0.3.0",
    "typescript": "npm:typescript@5.9.2",
    "uqr": "npm:uqr@^0.1.3",
    "valibot": "npm:valibot@^1.4.1",
    "wasm-feature-detect": "npm:wasm-feature-detect@^1.8.0"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "#jsx"
  }
}
